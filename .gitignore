# ==========================================
# Olist E-Commerce Analysis - Git Ignore Policy
# ==========================================

# 1. Virtual Environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# 2. Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.build/

# 3. Jupyter Notebook Checkpoints & Temp Files
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*.ipynb_checkpoints/

# 4. Large Datasets & Local Database Files (>50MB)
data/raw/
data/processed/cleaning/
data/processed/remaining/
database/*.db
database/*.sqlite
database/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Exception: Keep small KPI summaries & forecasting exports in Git
!data/processed/kpi/*.csv
!data/processed/forecast/*.csv

# 5. IDE & OS System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 6. Temporary Files & Binary Documents
*.tmp
*.temp
*.log
*.docx